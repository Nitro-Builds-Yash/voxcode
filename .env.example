# Copy to .env and adjust. Every setting is optional; see backend/config/settings.py.

# --- LLM provider: ollama | anthropic | openai | gemini | groq | openrouter
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Security (recommended if other people can reach this machine)
# API_TOKEN=change-me
# ALLOWED_REPO_ROOTS=/home/me/code
# ALLOWED_ORIGINS=http://localhost:3000

# --- Search
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANK_ENABLED=true
# CONTEXT_MAX_TOKENS=12000
# WATCH_ENABLED=false

# --- Storage: local (embedded) or server (docker-compose)
# QDRANT_MODE=local
# MEMORY_BACKEND=auto

# --- Voice
# WHISPER_MODEL=base
# TTS_ENGINE=auto
# PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
# EMOTION_ENABLED=true
