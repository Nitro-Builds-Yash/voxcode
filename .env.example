# Copy to .env and adjust. Every setting is optional; see docs/configuration.md.

# --- LLM provider: ollama | anthropic | openai | gemini | groq | openrouter
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Security (recommended if other people can reach this machine)
# API_TOKEN=change-me
# ALLOWED_REPO_ROOTS=/home/me/code
# ALLOWED_ORIGINS=http://localhost:3000

# --- Search
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANK_ENABLED=true
# CONTEXT_MAX_TOKENS=12000
# WATCH_ENABLED=false

# --- Storage: local (embedded) or server (docker-compose)
# QDRANT_MODE=local
# MEMORY_BACKEND=auto

# --- Voice
# WHISPER_MODEL=base
# TTS_ENGINE=auto
# PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
# EMOTION_ENABLED=true

# --- Privacy & cost ---
LOCAL_ONLY=false            # refuse remote LLM providers entirely
REDACT_SECRETS=true         # scrub keys/tokens before sending context to remote providers
# MODEL_PRICES={"claude-sonnet-4-5": [3.0, 15.0]}   # USD per 1M input/output tokens
# OPENAI_BASE_URL=http://localhost:8000/v1           # any OpenAI-compatible server (vLLM, LM Studio)

# --- Agent ---
NATIVE_TOOL_CALLING=true
PLAN_EDITS=true             # plan -> edit -> test -> repair
QUERY_REWRITE=false
PRECISE_CALL_GRAPH=true     # Jedi-resolved call edges
GIT_HISTORY_COMMITS=300
TEST_SANDBOX=auto           # auto | docker | local
SANDBOX_IMAGE=python:3.12-slim
# GITHUB_TOKEN=             # needed for apply target=pull_request

# --- Voice ---
VAD_SILENCE_SECONDS=0.8
VAD_ENERGY_THRESHOLD=0.015
# WAKE_WORD=hey_jarvis      # requires the [wakeword] extra

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=voxcode

# --- Rust ---
NATIVE_ACCEL=auto           # use the voxcode-native extension when installed; "off" forces pure Python
RUST_ANALYZER=auto          # rust-analyzer for the Rust call graph: auto | off | /path/to/rust-analyzer
RUST_ANALYZER_TIMEOUT=60

# --- Learning ---
LEARNED_RANKER=true
RANKER_AUTO_TRAIN=true
RANKER_MIN_FEEDBACK=10
CONTEXTUAL_CHUNKS=false     # one LLM call per changed file at index time (cached)
# CASCADE_PROVIDER=ollama
# CASCADE_MODEL=qwen3:1.7b  # small model for easy questions; empty = off
CASCADE_MAX_DIFFICULTY=0.5
CASCADE_MIN_GROUNDEDNESS=0.75
ANSWER_CACHE=true
INTENT_MODEL=true

# --- Network ---
# ALLOWED_HOSTS=devbox.lan   # extra host names (localhost / 127.0.0.1 / ::1 always work); blocks DNS rebinding

# --- Review ---
REVIEW_PORT=19432
# OBSIDIAN_VAULT=~/Documents/Obsidian/Main   # save approved plans here
# OBSIDIAN_FOLDER=VoxCode/Plans
